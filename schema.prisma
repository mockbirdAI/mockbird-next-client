generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  password            String
  firstName           String
  lastName            String
  role                UserRole
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  profileId           Int?
  candidateInterviews Interview[]        @relation("CandidateInterviews")
  recruiterInterviews Interview[]        @relation("RecruiterInterviews")
  candidateRequests   InterviewRequest[] @relation("CandidateRequests")
  recruiterRequests   InterviewRequest[] @relation("RecruiterRequests")
  profile             Profile?
}

model Profile {
  userId         String        @unique
  linkedinUrl    String?
  resumeUrl      String?
  bio            String?
  profilePicture String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  schoolId       Int?
  id             Int           @id @default(autoincrement())
  school         School?       @relation(fields: [schoolId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  UserCompany    UserCompany[]
}

model Company {
  id          Int           @id @default(autoincrement())
  name        String
  industry    String?
  size        String?
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  users       UserCompany[]
}

model UserCompany {
  id        Int       @id @default(autoincrement())
  userId    String
  companyId Int
  role      String
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  company   Company   @relation(fields: [companyId], references: [id])
  profile   Profile   @relation(fields: [userId], references: [userId])

  @@unique([userId, companyId])
}

model School {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Profile   Profile[]
}

model Interview {
  candidateId   String
  recruiterId   String
  scheduledTime DateTime
  duration      Int
  status        InterviewStatus
  feedback      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  requestId     Int?              @unique
  hostToken     String?
  meetingId     String?           @unique
  userToken     String?
  id            String            @id @default(uuid())
  downloadUrl   String?
  candidate     User              @relation("CandidateInterviews", fields: [candidateId], references: [id])
  recruiter     User              @relation("RecruiterInterviews", fields: [recruiterId], references: [id])
  request       InterviewRequest? @relation(fields: [requestId], references: [id])
  payment       Payment?
}

model InterviewRequest {
  id           Int           @id @default(autoincrement())
  candidateId  String
  recruiterId  String
  proposedTime DateTime
  status       RequestStatus
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  purpose      String?
  paymentId    String?       @unique
  Interview    Interview?
  candidate    User          @relation("CandidateRequests", fields: [candidateId], references: [id])
  recruiter    User          @relation("RecruiterRequests", fields: [recruiterId], references: [id])

  @@index([candidateId])
  @@index([recruiterId])
}

model Payment {
  id              Int           @id @default(autoincrement())
  amount          Float
  status          PaymentStatus
  transactionDate DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  interviewId     String        @unique
  interview       Interview     @relation(fields: [interviewId], references: [id])
}

enum UserRole {
  RECRUITER
  CANDIDATE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}
