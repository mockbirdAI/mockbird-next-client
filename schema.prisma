generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("POSTGRES_PRISMA_URL")
  relationMode = "foreignKeys"
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  password            String
  firstName           String
  lastName            String
  role                UserRole
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  profileId           Int?
  availability        DateTime[]         @default(dbgenerated("(ARRAY[]::timestamp without time zone[])::timestamp(3) without time zone[]"))
  services            Json[]
  candidateInterviews Interview[]        @relation("CandidateInterviews")
  recruiterInterviews Interview[]        @relation("RecruiterInterviews")
  candidateRequests   InterviewRequest[] @relation("CandidateRequests")
  recruiterRequests   InterviewRequest[] @relation("RecruiterRequests")
  profile             Profile?
  userFinances        UserFinances?
}

model Profile {
  userId          String        @unique
  linkedinUrl     String?
  resumeUrl       String?
  bio             String?
  profilePicture  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  schoolId        Int?
  id              Int           @id @default(autoincrement())
  UserSchool      UserSchool[]
  user            User          @relation(fields: [userId], references: [id])
  receivedReviews Review[]      @relation("ReceivedReviews")
  writtenReviews  Review[]      @relation("WrittenReviews")
  UserCompany     UserCompany[]
}

model Company {
  id          Int           @id @default(autoincrement())
  name        String
  industry    String?
  size        String?
  description String?
  logoUrl     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  users       UserCompany[]
}

model UserCompany {
  id        Int       @id @default(autoincrement())
  userId    String
  companyId Int
  role      String
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  company   Company   @relation(fields: [companyId], references: [id])
  profile   Profile   @relation(fields: [userId], references: [userId])

  @@unique([userId, companyId])
}

model UserFinances {
  userId       String @id
  pending      Float  @default(0.00)
  withdrawable Float  @default(0.00)
  user         User   @relation(fields: [userId], references: [id])
}

model School {
  id         Int          @id @default(autoincrement())
  name       String
  logoUrl    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  UserSchool UserSchool[]
}

model UserSchool {
  id        Int       @id @default(autoincrement())
  userId    String
  schoolId  Int
  degree    String
  major     String
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  school    School    @relation(fields: [schoolId], references: [id])
  profile   Profile   @relation(fields: [userId], references: [userId])

  @@unique([userId, schoolId])
}

model Interview {
  candidateId   String
  recruiterId   String
  scheduledTime DateTime
  duration      Int
  status        InterviewStatus
  feedback      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  requestId     Int?              @unique
  hostToken     String?
  meetingId     String?           @unique
  userToken     String?
  id            String            @id @default(uuid())
  downloadUrl   String?
  candidate     User              @relation("CandidateInterviews", fields: [candidateId], references: [id])
  recruiter     User              @relation("RecruiterInterviews", fields: [recruiterId], references: [id])
  request       InterviewRequest? @relation(fields: [requestId], references: [id])
  payment       Payment?
}

model InterviewRequest {
  id              Int           @id @default(autoincrement())
  candidateId     String
  recruiterId     String
  proposedTime    DateTime
  status          RequestStatus
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  purpose         String?
  paymentId       String?
  stripeSessionId String
  Interview       Interview?
  candidate       User          @relation("CandidateRequests", fields: [candidateId], references: [id])
  recruiter       User          @relation("RecruiterRequests", fields: [recruiterId], references: [id])

  @@index([candidateId])
  @@index([recruiterId])
}

model Payment {
  id              Int           @id @default(autoincrement())
  amount          Float
  status          PaymentStatus
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  interviewId     String        @unique
  payeeId         String
  payerId         String
  paymentIntentId String
  interview       Interview     @relation(fields: [interviewId], references: [id])
}

model Review {
  id              Int     @id @default(autoincrement())
  reviewText      String  @default("")
  score           Int
  reviewerId      Int
  revieweeId      Int
  revieweeProfile Profile @relation("ReceivedReviews", fields: [revieweeId], references: [id])
  reviewerProfile Profile @relation("WrittenReviews", fields: [reviewerId], references: [id])
}

enum UserRole {
  RECRUITER
  CANDIDATE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}
